# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here

# Monitoring Configuration
# Polling interval in minutes (default is 10 minutes)
POLLING_INTERVAL_MINUTES=10

# Worker batch size for parallel requests (default is 1 for smooth 200ms pacing)
WORKER_BATCH_SIZE=1

# Minimum 24h volume in USD (default is 500000)
MIN_VOLUME_USD=500000

# Minimum spike multiplier (default is 5 for 5X)
MIN_SPIKE_MULTIPLIER=5

# Base API & Web URLs
GECKOTERMINAL_V2_BASE_URL=https://api.geckoterminal.com/api/v2
GECKOTERMINAL_P1_BASE_URL=https://app.geckoterminal.com/api/p1
DEXSCREENER_API_BASE_URL=https://api.dexscreener.com/latest/dex/pairs
DEXSCREENER_WEB_BASE_URL=https://dexscreener.com
